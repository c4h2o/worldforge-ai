# ── AI 编排 / LLM ─────────────────────────────
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=claude-sonnet-4-5   # 或 gpt-4o / qwen 等

# ── 图生 3D Provider ──────────────────────────
IMG3D_PROVIDER=mock            # mock | tripo | triposr
TRIPO_API_KEY=                 # https://platform.tripo3d.ai/ (global) / platform.tripo3d.com (CN)
TRIPO_BASE_URL=https://openapi.tripo3d.ai/v3
TRIPOSR_WEIGHTS=               # 自托管 TripoSR 权重路径

# ── 图像生成 Provider ──────────────────────────
IMAGE_PROVIDER=mock            # mock | seedream | flux | sd
IMAGE_API_KEY=

# ── 基础设施 ──────────────────────────────────
POSTGRES_URL=postgres://worldforge:worldforge@localhost:5432/worldforge
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=worldforge
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ── 运行时 ────────────────────────────────────
NODE_ENV=development
PORT=3000
GPU_WORKERS=1
