# ── AI 编排 / LLM ─────────────────────────────
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=claude-sonnet-4-5   # 或 gpt-4o / qwen 等

# ── 图生 3D Provider ──────────────────────────
IMG3D_PROVIDER=mock            # mock | local（自研自托管重建引擎）
LOCAL_RECON_WEIGHTS=
LOCAL_RECON_ENDPOINT=http://localhost:8080            # 自研单图 3D 重建引擎（我们自建/自运维）

# ── 图像生成 Provider ──────────────────────────
IMAGE_PROVIDER=mock            # mock | seedream | flux | sd
IMAGE_API_KEY=

# ── 基础设施 ──────────────────────────────────
POSTGRES_URL=postgres://worldforge:worldforge@localhost:5432/worldforge
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=worldforge
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ── 运行时 ────────────────────────────────────
NODE_ENV=development
PORT=4321
GPU_WORKERS=1

# ── 图像生成（语义驱动生图，SenseNova 文生图）──
IMG_PROVIDER=mock
SENSENOVA_API_KEY=
SENSENOVA_BASE_URL=https://token.sensenova.cn/v1
SENSENOVA_IMAGE_MODEL=sensenova-u1.5-lite
